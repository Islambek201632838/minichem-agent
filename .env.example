# Free key: https://aistudio.google.com/apikey  (GEMINI_API_KEY is accepted as an alias)
GOOGLE_API_KEY=your-key-here
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional overrides (defaults shown)
# PUBCHEM_MODE=live            # live | offline (offline = small built-in fixture table)
# ENABLE_RETROSYNTHESIS=false  # needs a separate AiZynthFinder venv, see README
# AIZYNTH_CONFIG=/path/to/aizynth/data/config.yml
# AIZYNTH_PYTHON=/path/to/aizynth/.venv/bin/python

# API protection (see README, "Running the API as a local service")
# API_KEYS=key-one-at-least-16-chars,key-two-at-least-16-chars   # empty = no authentication
# AUTH_REQUIRED=false          # true = refuse to start without API_KEYS (compose sets it)
# RATE_LIMIT_PER_MINUTE=20     # /chat calls per key
# MAX_CONCURRENT_CHATS=4       # questions answered at once, more get 429
# REQUEST_TIMEOUT_S=300        # one question, then 504
# RETRO_MAX_CONCURRENT=1       # retrosynthesis searches at once
# SESSION_TTL_DAYS=7           # unused sessions are deleted
# SESSION_MAX_SESSIONS=200
# SESSION_MAX_TURNS=200
# REQUIRE_LLM_KEY=true         # false only for tests without a Gemini key
# ENABLE_REINVENT=false        # needs a separate REINVENT 4 venv and priors, see README
# REINVENT_PYTHON=/path/to/reinvent/.venv/bin/python
# REINVENT_PRIOR_DIR=/path/to/reinvent/priors   # holds mol2mol_medium_similarity.prior
# REINVENT_DEVICE=mps          # mps | cpu
# ENABLE_PRECEDENTS=false     # patent reaction precedents, needs a separate venv and data, see README
# PRECEDENTS_PYTHON=/path/to/precedents/.venv/bin/python
# PRECEDENTS_DATA_DIR=/path/to/precedents/data
# PRECEDENTS_BACKEND=local     # local | ord (hosted Open Reaction Database API; needs no venv or data)
# ORD_API_URL=https://open-reaction-database.org/api
# ORD_SEARCH_TIMEOUT_S=45
